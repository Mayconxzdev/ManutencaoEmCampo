# Dados locais da demonstração. Nenhuma variável de rede corporativa é usada.
MEC_DATA_DIR=./data
MEC_TIMEZONE=America/Sao_Paulo
MEC_APP_VERSION=1.0.0-demo

# Dossiês e backups são locais por padrão. Integrações externas devem ser
# configuradas conscientemente na implantação de quem executar o projeto.
# MEC_DOSSIER_DIR=./data/dossies
# MEC_BACKUP_EXTERNAL_DIR=

# Recursos opcionais de IA visual. Não informe chaves no Git.
OPENAI_VISION_ENABLED=False
OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
